{
  description = "Ayatsuri2D: an open, native 2D puppet studio";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    crane.url = "github:ipetkov/crane";
    flake-compat = {
      url = "github:NixOS/flake-compat";
      flake = false;
    };
  };

  outputs = { nixpkgs, crane, ... }:
    let
      # what packaging/env.sh sets for the other packages
      cargoToml = fromTOML (builtins.readFile ./Cargo.toml);
      version = cargoToml.workspace.package.version;
      appID = "io.github.Ayatsuri2D.Ayatsuri2D";

      forAllSystems = f:
        # Linux only: the desktop, MIME and audio pieces are Linux's
        nixpkgs.lib.genAttrs [ "x86_64-linux" "aarch64-linux" ] (system:
          let
            pkgs = nixpkgs.legacyPackages.${system};
            inherit (pkgs) lib;
            craneLib = crane.mkLib pkgs;

            # the workspace, plus what the crates embed at build time
            # (assets, the changelog, the C header) and the Linux files the
            # install puts beside the binaries
            src = lib.fileset.toSource {
              root = ./.;
              fileset = lib.fileset.unions [
                ./Cargo.toml
                ./Cargo.lock
                ./.cargo
                ./crates
                ./apps
                ./xtask
                ./assets
                ./packaging/linux
                ./CHANGELOG.md
                ./LICENSE
                ./LICENSING.md
                ./README.md
              ];
            };

            # winit and wgpu open these at run time by name, so they go on
            # the library path of the wrapped binaries; both display servers
            # are included and winit picks one when the app starts
            runtimeLibs = with pkgs; [
              wayland
              libxkbcommon
              libx11
              libxcursor
              libxi
              libxrandr
              vulkan-loader
              libGL
            ];

            commonArgs = {
              pname = "ayatsuri2d";
              inherit version src;
              strictDeps = true;
              # only the two apps, not the whole workspace
              cargoExtraArgs = "--locked -p ayatsuri -p ayatsuri-launcher";
              # the workspace tests run in the repository's CI
              doCheck = false;
              buildInputs = [ pkgs.alsa-lib pkgs.libxkbcommon ];
              nativeBuildInputs = [ pkgs.pkg-config pkgs.makeWrapper ];
            };

            cargoArtifacts = craneLib.buildDepsOnly commonArgs;

            ayatsuri = craneLib.buildPackage (commonArgs // {
              inherit cargoArtifacts;
              installPhaseCommand = ''
                install -Dm755 target/release/ayatsuri "$out/bin/ayatsuri"
                install -Dm755 target/release/ayatsuri-launcher "$out/bin/ayatsuri-launcher"

                here=packaging/linux
                install -Dm644 "$here/${appID}.desktop" "$out/share/applications/${appID}.desktop"
                install -Dm644 "$here/${appID}.mime.xml" "$out/share/mime/packages/${appID}.xml"
                # generated by `cargo xtask metainfo`, checked in CI
                install -Dm644 "$here/${appID}.metainfo.xml" "$out/share/metainfo/${appID}.metainfo.xml"
                mkdir -p "$out/share/icons"
                cp -R assets/app-icon/hicolor "$out/share/icons/"

                doc="$out/share/doc/ayatsuri2d"
                install -Dm644 -t "$doc" LICENSE LICENSING.md README.md assets/credits.tsv
              '';
              postFixup = ''
                # nixpkgs' ffmpeg comes first on PATH, so video export uses
                # it and the app never offers to download its own
                for b in ayatsuri ayatsuri-launcher; do
                  wrapProgram "$out/bin/$b" \
                    --prefix LD_LIBRARY_PATH : "${lib.makeLibraryPath runtimeLibs}" \
                    --prefix PATH : "${lib.makeBinPath [ pkgs.ffmpeg ]}"
                done
              '';
              meta = {
                description = cargoToml.workspace.package.description;
                homepage = "https://ayatsuri-2d.org";
                license = with lib.licenses; [ gpl3Only mit asl20 ];
                mainProgram = "ayatsuri-launcher";
                platforms = lib.platforms.linux;
              };
            });
          in
          f { inherit pkgs craneLib ayatsuri runtimeLibs; });
    in
    {
      packages = forAllSystems ({ ayatsuri, ... }: {
        default = ayatsuri;
        ayatsuri2d = ayatsuri;
      });

      apps = forAllSystems ({ ayatsuri, ... }: {
        default = {
          type = "app";
          program = "${ayatsuri}/bin/ayatsuri-launcher";
        };
      });

      devShells = forAllSystems ({ pkgs, craneLib, ayatsuri, runtimeLibs, ... }: {
        default = craneLib.devShell {
          inputsFrom = [ ayatsuri ];
          packages = [ pkgs.ffmpeg ];
          LD_LIBRARY_PATH = pkgs.lib.makeLibraryPath runtimeLibs;
        };
      });
    };
}
